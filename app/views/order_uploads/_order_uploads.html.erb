<% if order_uploads.first.admin_end? %>
  <% selected_tab = 'admin_end' %>
<% else %>
  <% selected_tab = 'store_front' %>
<% end %>

<div class="panel panel-default">  
  <div class="table-responsive">
    <table class="table table-striped table-hover ">
      <thead>
        <tr>
          <th>#</th>
          <th>Email</th>
          <th nowrap>Email Subscribed</th> 
          <th>Status</th>
          <th><%= sort_link(@q, :file_updated_at, 'Uploaded At', default_order: :desc, params: { selected_tab: selected_tab, reset_pagination: true }) %></th>
          <th nowrap width="176px">Product</th>
          <th>Uploaded File</th>
          <th nowrap>Error file</th>
          <th></th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% order_uploads.each.with_index(1) do |order_upload, index| %>
          <tr>
            <td>
              <% if selected_tab == 'admin_end' %>
                <% if params[:admin_end_page].present? %>
                  <%= index + (params[:admin_end_page].to_i - 1) * OrderUpload::PER_PAGE_LIMIT %>
                <% else %>
                  <%= index %>
                <% end %>
              <% else %>
                <% if params[:store_front_page].present? %>
                  <%= index + (params[:store_front_page].to_i - 1) * OrderUpload::PER_PAGE_LIMIT %>
                <% else %>
                  <%= index %>
                <% end %>
              <% end %>
            </td>
            <td nowrap><%= order_upload.source_email%></td>
            <td><%= order_upload.send_receipt%></td>
            <td nowrap><%= order_upload.status.humanize%></td>
            <td nowrap><%= order_upload.file_updated_at %></td>
            <td><a href="https://<%=current_shop.shopify_domain%>/admin/products/<%=order_upload.shopify_product_id%>" target="_blank"><%= order_upload.shopify_product_title %></a>
            </td>
            <td nowrap><%= link_to t(:uploaded_order_file, scope: :action), order_upload.file.url(:original, false) %></td>
            <td nowrap>
              <% if order_upload.errors_file.exists? %>
                <%= link_to t(:error_file, scope: :action), order_upload.errors_file.url(:original, false), target: '_blank' %>
              <% else %>
                No Errors File
              <% end%>
            </td>
              <% if order_upload.class::FAILURE_STATUS.keys.include? order_upload.status.to_sym %>
                <%= form_with scope: :order_upload, url: order_upload_path(order_upload), local: true, method: :patch do |form| %>
                  <td>
                    <%= form.file_field :file, class: 'custom-file-upload-btn' %>
                  </td>
                  <td>
                    <%= form.submit I18n.t(:reupload, scope: :action), class: 'btn btn-primary btn-sm' %>
                  </td>
                <% end %>
                <% else %>
                <td colspan="2"></td>
              <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="text-center">
  <%= will_paginate order_uploads, param_name: selected_tab + '_page', params: { q: @ransack_param, selected_tab: selected_tab, reset_pagination: nil }, class: 'visible-ms-inline' %>
</div>
<p class="row"></p>


<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <% application_name = ShopifyApp.configuration.application_name %>
    <title><%= application_name %></title>
    <%= stylesheet_link_tag 'application' %>
    <%= javascript_include_tag 'application', "data-turbolinks-track" => true %>
    <%= javascript_include_tag 'flash_messages', 'data-turbolinks-track' => true %>
    <%= javascript_include_tag 'app_menu', 'data-turbolinks-track' => true %>
    <%= csrf_meta_tags %>
  </head>

  <body>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav mr-auto">
          <li class="nav-item">
            <%= link_to 'Home |', root_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Create Bulk Order |', new_order_upload_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Find Country Data |', countries_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to 'Modify Theme', edit_themes_path, class: "nav-link" %>
          </li>
        </ul>
      </div>
    </nav>
    <div class="app-wrapper">
      <div class="app-content">
        <main role="main">
          <br>
          <%= render 'shared/content_header' %>
          <br>
          <%= yield %>
        </main>
      </div>
    </div>

    <%= render 'layouts/flash_messages' %>

    <script src="https://unpkg.com/@shopify/app-bridge@3"></script>

    <script type="text/javascript">
      var AppBridge = window['app-bridge'];
      var createApp = AppBridge.default;
      var app = createApp({
        apiKey: "<%= ShopifyApp.configuration.api_key %>",
        host: "<%= params[:host] %>",
        forceRedirect: true
      });
    </script>

    <% if content_for?(:javascript) %>
      <div id="ContentForJavascript" data-turbolinks-temporary>
        <%= yield :javascript %>
      </div>
    <% end %>
  </body>
</html>
